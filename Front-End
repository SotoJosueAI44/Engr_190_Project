<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>House Paint Calculator</title>

    <style>

        /* Entire page styling */
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        /* Main container */
        .container {
            width: 500px;
            margin: 50px auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        /* Title styling */
        h1 {
            text-align: center;
            color: #333;
        }

        /* Label styling */
        label {
            font-weight: bold;
            display: block;
            margin-top: 15px;
        }

        /* Input box styling */
        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        /* Button styling */
        button {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: #007BFF;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        /* Button hover effect */
        button:hover {
            background-color: #0056b3;
        }

        /* Results section */
        .results {
            margin-top: 25px;
            padding: 15px;
            background-color: #e9ecef;
            border-radius: 5px;
        }

    </style>
</head>

<body>

    <div class="container">

        <h1>🏠 House Paint Calculator</h1>

        <!-- User Inputs -->

        <label>Room Length (ft)</label>
        <input type="number" id="length">

        <label>Room Width (ft)</label>
        <input type="number" id="width">

        <label>Wall Height (ft)</label>
        <input type="number" id="height">

        <label>Number of Coats</label>
        <input type="number" id="coats">

        <label>Price Per Gallon ($)</label>
        <input type="number" id="price">

        <!-- Calculate Button -->
        <button onclick="calculatePaint()">
            Calculate Paint Needed
        </button>

        <!-- Results Area -->
        <div class="results">

            <h2>Results</h2>

            <p id="paintNeeded">
                Paint Buckets Needed: 
            </p>

            <p id="totalCost">
                Total Cost:
            </p>

        </div>

    </div>

    <script>

        // Function to calculate paint and cost
        function calculatePaint() {

            // Get user inputs
            let length = parseFloat(document.getElementById("length").value);
            let width = parseFloat(document.getElementById("width").value);
            let height = parseFloat(document.getElementById("height").value);
            let coats = parseInt(document.getElementById("coats").value);
            let price = parseFloat(document.getElementById("price").value);

            // Paint coverage constant
            // 1 gallon covers approximately 350 square feet
            const COVERAGE = 350;

            // Calculate wall area
            let wallArea = 2 * (length * height) + 2 * (width * height);

            // Multiply by coats
            let totalArea = wallArea * coats;

            // Calculate gallons needed
            let gallonsNeeded = totalArea / COVERAGE;

            // Round up to nearest whole bucket
            let buckets = Math.ceil(gallonsNeeded);

            // Calculate total cost
            let totalCost = buckets * price;

            // Display results
            document.getElementById("paintNeeded").innerHTML =
                "Paint Buckets Needed: " + buckets;

            document.getElementById("totalCost").innerHTML =
                "Total Cost: $" + totalCost.toFixed(2);
        }

    </script>

</body>
</html>
